{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/asset-evidence.schema.json",
  "title": "AssetEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source", "observed_at", "attributes"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "string",
      "enum": ["opentelemetry_trace", "kubernetes_state", "host_cloud_metadata", "servicegraph_metrics", "metric_alert_contract"]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "string",
      "enum": ["resource", "span", "metric_datapoint", "log", "kubernetes_object", "cloud_object", "derived_metric"]
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "array", "object", "null"]
      }
    }
  }
}
